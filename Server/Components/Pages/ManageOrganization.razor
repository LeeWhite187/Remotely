@page "/manage-organization"
@attribute [Authorize]
@inherits AuthComponentBase

@*
    FR-30 / spec §2.7: OrganizationAdminRequirementHandler resolves the target
    org from a route/query parameter — Blazor `@page` routes don't carry one,
    so we self-gate via IsOrgAdmin in OnInitializedAsync (see .razor.cs).
    This matches the spec's explicit guidance in FR-30:
    "Blazor circuit pages gate org-admin access through
     IActiveOrganizationContext.IsOrgAdmin and DataService method checks."
*@

<h3 class="mb-3">Manage Organization</h3>

@if (_isLoading)
{
    <h5>Loading...</h5>
}
else if (User is not null)
{
    <div class="row">
        <div class="col-sm-8">
            @* Organization ID *@
            <div class="form-group mw">
                <label class="mb-1">Organization ID</label>
                <input readonly class="form-control" value="@_organization?.ID" />
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-sm-8">
            @* Organization Name *@
            <div class="form-group mw">
                <label class="mb-1">Organization Name</label>

                <div class="input-group">
                    <input @onchange="OrganizationNameChanged"
                           value="@_organization?.OrganizationName"
                           maxlength="25"
                           placeholder="Enter a name for your organization" 
                           class="form-control" 
                           autocomplete="off" />
                </div>
                <div class="text-info small">
                    * Requires browser refresh.
                </div>
            </div>
            @if (User.IsServerAdmin)
            {
                <div class="form-group">
                    <label class="mb-1">Default Organization For Server</label>
                    <button class="btn btn-sm btn-secondary ms-2" @onclick="ShowDefaultOrgHelp">
                        <span class="oi oi-question-mark"></span>
                    </button>
                    <br />
                    <input type="checkbox" checked="@_organization?.IsDefaultOrganization" @onchange="DefaultOrgCheckChanged" />
                </div>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-sm-8">
            @* Device Groups *@
            <div class="form-group">
                <label class="mb-1">Device Groups</label>
                <button class="btn btn-sm btn-secondary ms-2" @onclick="ShowDeviceGroupHelp">
                    <span class="oi oi-question-mark"></span>
                </button>

                <select class="form-control mb-1" @bind="_selectedDeviceGroupId" size="4">
                    @foreach (var deviceGroup in _deviceGroups)
                    {
                        <option @key="deviceGroup.ID" value="@deviceGroup.ID">@deviceGroup.Name</option>
                    }
                </select>

                <div class="text-end mb-3">
                    <button type="button" class="btn btn-danger" @onclick="DeleteSelectedDeviceGroup">Delete</button>
                </div>

                <div class="input-group">
                    <input placeholder="Add new device group" class="form-control" maxlength="200"
                           @bind="_newDeviceGroupName"
                           @bind:event="oninput"
                           @onkeypress="EvaluateNewDeviceGroupKeyPress" />
                    <button type="submit" class="btn btn-secondary" @onclick="CreateNewDeviceGroup">Add</button>
                </div>
            </div>

        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            @* Users — per §9.3: admin toggle, CanInvite toggle (FR-21),
               Remove-from-org (FR-20) distinct from full account deletion. *@
            <div class="form-group">
                <label class="control-label">Users</label>
                <button class="btn btn-sm btn-secondary ms-2" @onclick="ShowUsersHelp">
                    <span class="oi oi-question-mark"></span>
                </button>
                <table class="table table-dark table-striped table-hover" style="max-height: 400px">
                    <thead>
                        <tr>
                            <th>User Name</th>
                            <th>Admin</th>
                            <th>Can Invite</th>
                            <th>Device Groups</th>
                            <th>Reset Password</th>
                            <th>Remove from Org</th>
                            <th>Delete User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var orgUser in _orgUsers)
                        {
                            <tr @key="orgUser.Id">
                                <td class="middle-aligned"><label class="control-label">@orgUser.UserName</label></td>
                                @if (User.Id == orgUser.Id)
                                {
                                    @* Self: cannot demote, revoke invite, remove, or delete self. *@
                                    <td><input type="checkbox" readonly disabled checked="@IsAdminOf(orgUser)" /></td>
                                    <td><input type="checkbox" readonly disabled checked="@CanInviteOf(orgUser)" /></td>
                                    <td><button type="button" class="btn btn-secondary" title="Edit" @onclick="() => EditDeviceGroups(orgUser)">Edit</button></td>
                                    <td></td>
                                    <td><button type="button" class="btn btn-danger" disabled>Remove</button></td>
                                    <td><button type="button" class="btn btn-danger delete-user-button" disabled>Delete</button></td>
                                }
                                else
                                {
                                    <td><input type="checkbox" @onchange="(ev) => SetUserIsAdmin(ev, orgUser)" checked="@IsAdminOf(orgUser)" /></td>
                                    <td><input type="checkbox" @onchange="(ev) => SetUserCanInvite(ev, orgUser)" checked="@CanInviteOf(orgUser)" /></td>
                                    <td><button type="button" class="btn btn-secondary" title="Edit" @onclick="() => EditDeviceGroups(orgUser)">Edit</button></td>
                                    <td><button type="button" class="btn btn-danger" title="Reset Password" @onclick="() => ResetPassword(orgUser)">Reset</button></td>
                                    <td><button type="button" class="btn btn-warning" title="Remove from this organization (does not delete the account)" @onclick="() => RemoveFromOrg(orgUser)">Remove</button></td>
                                    <td><button type="button" class="btn btn-danger" title="Delete user account entirely" @onclick="() => DeleteUser(orgUser)">Delete</button></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    @* Invitations table — per KD-04 invitees always get base privileges, so no admin column. *@
    <div class="row">
        <div class="col-sm-12">
            <div class="form-group">
                <label class="control-label">Pending Invitations</label>
                <button class="btn btn-sm btn-secondary ms-2" @onclick="ShowInvitesHelp">
                    <span class="oi oi-question-mark"></span>
                </button>
                <table id="invitesTable" class="table table-dark table-striped table-hover" style="max-height: 400px">
                    <thead>
                        <tr>
                            <th>Invited Email</th>
                            <th>Link</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invite in _invites)
                        {
                            <tr @key="invite.ID">
                                <td class="middle-aligned"><label class="control-label">@invite.InvitedUser</label></td>
                                <td class="middle-aligned">
                                    <label class="control-label">
                                        <a href="@(NavManager.BaseUri)Invite/@invite.ID">Join Link</a>
                                    </label>
                                </td>
                                <td><button type="button" class="btn btn-danger" invite="@invite.ID" @onclick="() => DeleteInvite(invite)">Delete</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    @* §9.3: split into Add Existing User (no email) and Invite New User (email). *@
    <div class="row">
        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label">Add Existing User</label>
                <div class="text-info small">
                    Adds an existing Remotely account to this organization with base privileges.
                </div>
                <div class="input-group">
                    <input @bind="_addExistingInput" @bind:event="oninput"
                           placeholder="Username or email"
                           required
                           class="form-control"
                           @onkeypress="EvaluateAddExistingKeypress" />
                    <button type="button" class="btn btn-primary" @onclick="AddExistingUser">Add to Org</button>
                </div>
            </div>
        </div>

        <div class="col-sm-6">
            <div class="form-group">
                <label class="control-label">Invite New User</label>
                <div class="text-info small">
                    Sends an email invitation to a new (not-yet-registered) email address.
                </div>
                <div class="input-group">
                    <input @bind="_inviteEmail" @bind:event="oninput"
                           placeholder="Email address"
                           type="email"
                           required
                           class="form-control"
                           @onkeypress="EvaluateInviteInputKeypress" />
                    <button type="button" class="btn btn-primary" @onclick="SendInvite">Send Invitation</button>
                </div>
            </div>
        </div>
    </div>

}